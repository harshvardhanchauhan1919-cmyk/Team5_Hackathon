# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# Which backend model_for() (config/__init__.py) routes diagnosis/repair calls
# through. One of: api | opencode | claude. See README.md "Run modes".
LLM_BACKEND=api

# --- LLM_BACKEND=api (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM_BACKEND=opencode (headless `opencode` CLI, no API key needed here) ---
# OPENCODE_MODEL=github-copilot/gpt-5.5
# OPENCODE_TIMEOUT=180

# --- LLM_BACKEND=claude (headless `claude` CLI, no API key needed here) ---
# CLAUDE_MODEL=sonnet
# CLAUDE_TIMEOUT=180

# Dev flags
USE_MOCK=1        # route LLM calls through the deterministic mock (tools/mock_llm.py)
                   # — wins over LLM_BACKEND; use for tests/CI, not for a real demo run.
HITL=0             # 1 = human approves each repair; 0 = fully autonomous
