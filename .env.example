# Copy to .env and fill in. NEVER commit .env (it's gitignored).
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Dev flags
USE_MOCK=1        # route LLM calls through the deterministic mock (tools/mock_llm.py)
HITL=0            # 1 = human approves each repair; 0 = fully autonomous
